# Dados reais (SQLite) — não versionar
*.db
*.db-journal
*.db-wal
*.db-shm

# Conversa do WhatsApp (tem dado pessoal do dono — LGPD)
WhatsApp Chat - AmazonLinks/
WhatsApp Chat - AmazonLinks.zip
_chat.txt

# Logs e progresso de coleta (logs/: saídas do verificar.py e das rodadas operacionais)
*.log
logs/
coleta_amazon_feitos.txt
coleta_shopee_feitos.txt
coleta_ml_feitos.txt
atualizar_precos_feitos.txt
# Backups do banco e do progresso (migrar_categorias.py e etapa 0 dos planos)
backups/

# Trava de rodada por loja (servidor.travar_rodada): <banco>.rodada-<loja>.lock ao lado do banco
*.db.rodada-*.lock

# Python
__pycache__/
*.pyc

# Segredos
.env*
!.env.example
# Token da API v1 para o Achadinho Turbo (servidor.py, ACHADINHOS_API_TOKEN_ARQUIVO)
api_token.txt
api_cabecalho.txt
# Tokens da API oficial do Mercado Livre (ml_api.py, ACHADINHOS_ML_TOKENS) e a trava da renovação
ml_tokens.json
ml_tokens.json.lock
# sobra da escrita atômica (.ml_tokens.json.<16 hex>.tmp) quando o processo morre no meio: tem os tokens
.ml_tokens.json.*.tmp
# Vínculos anúncio → produto de catálogo do ML (ml_api.py, ACHADINHOS_ML_CATALOGO): cache local, sem segredo,
# e a sobra da escrita atômica (.ml_catalogo.json.<16 hex>.tmp)
ml_catalogo.json
.ml_catalogo.json.*.tmp

# Garimpo feminino (tools/garimpo_feminino): exports, logs e a trava da rodada; o garimpo.db (e -wal/-shm)
# já cai no *.db acima
tools/garimpo_feminino/exports/
tools/garimpo_feminino/logs/
tools/garimpo_feminino/garimpo.lock
# sobra da escrita atômica dos docs (.<arquivo>.<aleatório>.tmp) quando o processo morre no meio
tools/garimpo_feminino/docs/.*.tmp

# Estado local do Claude Code
.claude/scheduled_tasks.lock
.claude/settings.local.json
